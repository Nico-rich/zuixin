generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL") // 持久 shadow 库（预装 pgvector，重放含 CREATE EXTENSION 的历史迁移所需）
}

// ===== 枚举 =====
enum UserRole {
  user
  admin
}
enum UserStatus {
  active
  disabled
}
enum MessageRole {
  user
  assistant
  system
  tool
}
enum MessageStatus {
  pending
  streaming
  completed
  failed
  cancelled
}
enum IntentType {
  chat
  image_generation
  video_generation
  image_analysis
  file_analysis
  agent_task
  workflow
}
enum AttachmentType {
  image
  video
  file
}
enum AttachmentKind {
  upload
  generated_image
  generated_video
  generated_file
}

// ===== M2 枚举 =====
enum MemoryScope {
  user
  project
}
enum MemoryCategory {
  preference
  profile
  instruction
  project_context
  workflow
  other
}
enum MemoryStatus {
  candidate
  active
  rejected
}
enum ArtifactType {
  creative_brief
  image
  video
  report
  analysis
  other
}
enum ArtifactStatus {
  draft
  ready
  failed
}
enum AttachmentStatus {
  uploading
  ready
  failed
}
enum ProviderType {
  llm
  image
  video
  embedding
}
enum HealthStatus {
  untested
  healthy
  unhealthy
}
enum ModelType {
  llm
  image
  video
  embedding
}
enum TaskType {
  image
  video
}
enum TaskStatus {
  pending
  processing
  completed
  failed
  cancelled
}
enum UsageKind {
  llm_chat
  llm_router
  image
  video
}
enum UsageStatus {
  success
  failed
}

// ===== 用户与认证 =====
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  role         UserRole  @default(user)
  status       UserStatus @default(active)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  conversations Conversation[]
  messages      Message[]
  attachments   Attachment[]
  tasks         GenerationTask[]
  usages        UsageRecord[]
  sessions      Session[]
  projects      Project[]
  memories      Memory[]
  artifacts     Artifact[]
  agentRuns     AgentRun[]
  approvals     Approval[]
  connections   Connection[]
  oauthStates   OAuthState[]
  externalActions ExternalAction[]
  commerceProducts    CommerceProduct[]
  commerceOrders      CommerceOrder[]
  commerceTraffic     CommerceTrafficMetric[]
  commerceConversions CommerceConversionMetric[]
  commerceCampaigns   CommerceCampaign[]
  commerceAdMetrics   CommerceAdMetric[]
  commerceInventory   CommerceInventoryMetric[]
  commerceRevenue     CommerceRevenueMetric[]
  commerceAnalyses  CommerceAnalysis[]
  creativeBriefs    CreativeBrief[]
  workflows         Workflow[]
  workflowRuns      WorkflowRun[]
  feedbacks         Feedback[]
  creativePerformances CreativePerformance[]
  performanceSnapshots PerformanceSnapshot[]
  auditLogs         AuditLog[]
  organizationMemberships OrganizationMember[]
  knowledgeBases KnowledgeBase[]
  documents      Document[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  @@index([userId])
}

// ===== 对话 =====
model Conversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title     String   @default("新对话")
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  Message[]
  summaries ConversationSummary[]
  artifacts Artifact[]
  agentRuns AgentRun[]
  @@index([userId, updatedAt])
  @@index([projectId])
}

model Message {
  id               String          @id @default(uuid())
  conversationId   String
  conversation     Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  role             MessageRole
  content          String          @db.Text
  intentType       IntentType?
  intentConfidence Float?
  agentId          String?
  agent            Agent?          @relation(fields: [agentId], references: [id])
  modelId          String?
  status           MessageStatus   @default(completed)
  errorCode        String?
  tokenUsage       Json?
  createdAt        DateTime        @default(now())
  attachments      Attachment[]
  tasks            GenerationTask[]
  @@index([conversationId, createdAt])
}

// ===== 附件（上传与生成产物统一管理）=====
model Attachment {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  conversationId  String?
  messageId       String?
  message         Message?         @relation(fields: [messageId], references: [id])
  kind            AttachmentKind
  type            AttachmentType
  mimeType        String
  storageKey      String
  storageProvider String           @default("local")
  originalName    String?
  sizeBytes       Int
  metadata        Json?
  status          AttachmentStatus @default(ready)
  taskId          String?
  task            GenerationTask?  @relation(fields: [taskId], references: [id])
  createdAt       DateTime         @default(now())
  @@index([userId, createdAt])
  @@index([messageId])
}

// ===== Agent =====
model Agent {
  id              String    @id @default(uuid())
  slug            String    @unique
  name            String
  description     String?
  enabled         Boolean   @default(true)
  priority        Int       @default(100)
  builtin         Boolean   @default(false)
  kind            String    @default("builtin") // builtin(代码类) | custom(纯 prompt 配置)
  scope           String    @default("system") // system | organization | user
  organizationId  String?   // M8-P1：scope=organization 时必填
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  activeVersionId String?   @unique
  activeVersion   AgentVersion? @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messages        Message[]
  runs            AgentRun[]
  versions        AgentVersion[]
}

// ===== Provider 与模型 =====
model Provider {
  id              String       @id @default(uuid())
  name            String
  type            ProviderType
  adapter         String
  baseUrl         String
  apiKeyEncrypted String       @default("")
  enabled         Boolean      @default(false)
  priority        Int          @default(100)
  timeoutMs       Int          @default(60000)
  retryConfig     Json?
  healthStatus    HealthStatus @default(untested)
  health          Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  models          Model[]
  tasks           GenerationTask[]
  usages          UsageRecord[]
  @@index([type, enabled])
}

model Model {
  id            String     @id @default(uuid())
  providerId    String
  provider      Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name          String
  apiModelId    String
  type          ModelType
  capabilities  Json?
  inputPrice    Float      @default(0)
  outputPrice   Float      @default(0)
  unitPrice     Float      @default(0)
  contextWindow Int?
  enabled       Boolean    @default(true)
  priority      Int        @default(100)
  isDefault     Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  agentVersions AgentVersion[]
  tasks         GenerationTask[]
  usages        UsageRecord[]
  @@index([type, enabled])
}

// ===== 生成任务 =====
model GenerationTask {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  conversationId String?
  messageId      String?
  message        Message?    @relation(fields: [messageId], references: [id])
  type           TaskType
  providerId     String?
  provider       Provider?   @relation(fields: [providerId], references: [id])
  modelId        String?
  model          Model?      @relation(fields: [modelId], references: [id])
  status         TaskStatus  @default(pending)
  progress       Int?
  statusMessage  String?
  input          Json
  output         Json?
  remoteTaskId   String?
  errorCode      String?
  errorMessage   String?
  attempts       Int         @default(0)
  idempotencyKey String?     @unique
  runId          String?     // AgentRun 追溯（非 Agent 场景为 null）
  run            AgentRun?   @relation(fields: [runId], references: [id], onDelete: Restrict)
  toolCallId     String?     // ToolCall 追溯（非 Agent 场景为 null）
  toolCall       ToolCall?   @relation(fields: [toolCallId], references: [id], onDelete: Restrict)
  costEstimate   Float?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  attachments    Attachment[]
  @@index([userId, createdAt])
  @@index([status])
  @@index([runId])
  @@index([toolCallId])
}

// ===== 用量与成本 =====
model UsageRecord {
  id             String      @id @default(uuid())
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  conversationId String?
  messageId      String?
  taskId         String?
  runId          String?
  providerId     String?
  provider       Provider?   @relation(fields: [providerId], references: [id])
  modelId        String?
  model          Model?      @relation(fields: [modelId], references: [id])
  kind           UsageKind
  inputTokens    Int         @default(0)
  outputTokens   Int         @default(0)
  imageCount     Int         @default(0)
  videoSeconds   Int         @default(0)
  latencyMs      Int?
  estimatedCost  Float       @default(0)
  status         UsageStatus @default(success)
  errorCode      String?
  createdAt      DateTime    @default(now())
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([runId])
}

// ===== 系统配置 =====
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ===== M2: Project =====
model Project {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?      // M8-P1：项目必须属于组织（存量 backfill 后服务层新建必填；nullable 为历史兼容）
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name          String
  description   String?      @db.Text
  metadata      Json?
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  conversations Conversation[]
  memories      Memory[]
  artifacts     Artifact[]
  agentRuns     AgentRun[]
  approvals     Approval[]
  connections   Connection[]
  externalActions ExternalAction[]
  commerceAnalyses CommerceAnalysis[]
  creativeBriefs   CreativeBrief[]
  workflows        Workflow[]
  knowledgeBases KnowledgeBase[]
  documents       Document[]
  @@index([userId, updatedAt])
}

// ===== M2: Memory（单表，scope 区分 user/project）=====
// confidence：AI 判断"这是否值得保存"的置信度（提取时，0~1）
// importance：该记忆对未来任务的重要程度（0~100，ContextAssembler 读取排序用）
// 两者是不同概念，不合并。
model Memory {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope           MemoryScope
  projectId       String?        // scope=project 时必填（服务层校验）
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content         String         @db.Text
  category        MemoryCategory
  source          String?        // manual | extractor | assistant
  sourceMessageId String?
  importance      Int            @default(50) // 0~100
  confidence      Float?                       // 提取置信度（candidate 阶段）
  status          MemoryStatus   @default(candidate)
  lastUsedAt      DateTime?                    // 最近一次被上下文组装使用（暂不参与排序，供统计/淘汰预留）
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  @@index([userId, scope, status])
  @@index([projectId, scope, status])
}

// ===== M2: ConversationSummary（仅结构，M6 自动摘要）=====
model ConversationSummary {
  id                        String       @id @default(uuid())
  conversationId            String       @unique
  conversation              Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  summary                   String       @db.Text
  summarizedThroughMessageId String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
}

// ===== M2: Artifact（制品层，仅结构，不做 Workflow）=====
model Artifact {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId      String?
  taskId         String?
  runId          String?        // AgentRun 追溯（非 Agent 场景为 null）
  run            AgentRun?      @relation(fields: [runId], references: [id], onDelete: Restrict)
  toolCallId     String?        // ToolCall 追溯（非 Agent 场景为 null）
  toolCall       ToolCall?      @relation(fields: [toolCallId], references: [id], onDelete: Restrict)
  type           ArtifactType
  title          String
  summary        String?        @db.Text
  content        Json?
  storageKey     String?
  idempotencyKey String?        // M6: resume 重放去重（部分唯一索引，见 migration）
  status         ArtifactStatus @default(ready)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  @@index([userId, createdAt])
  @@index([projectId])
  @@index([conversationId])
  @@index([runId])
  @@index([toolCallId])
}

// ===== M4: Agent 执行 =====
enum AgentRunStatus {
  queued
  running
  waiting // M6: run 存活但无 worker，等待外部异步任务（GenerationTask）完成
  completed
  failed
  cancelled
  timeout
}
enum AgentRunStepType {
  reasoning
  tool_call
  tool_result
  final
}
enum AgentRunStepStatus {
  running
  completed
  failed
  cancelled
}
enum ToolCallStatus {
  running
  completed
  failed
  waiting_approval // M7-P1: 等待人工审批（Approval 决定后 resume 继续执行或失败回喂）
}

model AgentRun {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent          @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentVersionId String?
  agentVersion   AgentVersion?  @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status         AgentRunStatus @default(running)
  currentStep    Int            @default(0)
  maxSteps       Int            @default(8)
  errorCode      String?
  errorMessage   String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  // ===== M6: Long-running Agent Runtime（P1 数据层；claim/renew/recover 逻辑 P3 实现）=====
  workerId        String?      // lease 持有者（worker 实例 id）；NULL = 同步 run（M5 语义，sweep 沿用 120s）
  leaseUntil      DateTime?    // 租约到期时刻（心跳续期）
  heartbeatAt     DateTime?    // 最近心跳（可观测）
  waitingOnTaskId     String?      // waiting 时等待的 GenerationTask
  waitingOnApprovalId String?      // M7-P1: waiting 时等待的 Approval（与 waitingOnTaskId 互斥）
  waitingOnApproval   Approval?    @relation("RunWaitingApproval", fields: [waitingOnApprovalId], references: [id], onDelete: SetNull)
  externalActions     ExternalAction[]
  approvals           Approval[]   // 本 run 产生的审批
  commerceAnalyses    CommerceAnalysis[]
  creativeBriefs      CreativeBrief[]
  // ===== M7-P7: 委派血缘（父/发起者/深度；child 权限 ⊆ parent 权限由服务层保证）=====
  parentRunId         String?
  parentRun           AgentRun?   @relation("DelegationParent", fields: [parentRunId], references: [id], onDelete: SetNull)
  children            AgentRun[]  @relation("DelegationParent")
  delegatedByRunId    String?     // 发起委派的 run（直接父）
  depth               Int         @default(0) // root=0；每层委派 +1（上限 limits.delegationMaxDepth）
  waitingOnDelegationId String?   // waiting 时等待的 AgentDelegation（子 run 终态唤醒）
  delegationsAsParent AgentDelegation[] @relation("DelegationParent")
  delegationsAsChild  AgentDelegation[] @relation("DelegationChild")
  retryOfRunId    String?      // Retry = 新 Run 血缘（不重新打开 terminal run）
  retryOf         AgentRun?  @relation("RetryChain", fields: [retryOfRunId], references: [id], onDelete: SetNull)
  retries         AgentRun[] @relation("RetryChain")
  attempt         Int          @default(1)
  steps          AgentRunStep[]
  tasks          GenerationTask[]
  artifacts      Artifact[]
  messages       AgentRunMessage[]
  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([status])
  @@index([retryOfRunId])
  @@index([waitingOnTaskId])
  @@index([waitingOnApprovalId])
  @@index([parentRunId])
  @@index([delegatedByRunId])
  @@index([waitingOnDelegationId])
}

// ===== M7-P1: Approval（Human-in-the-loop；M6 waiting 的第二种等待目标）=====
enum ApprovalStatus {
  requested
  approved
  rejected
  expired
  cancelled
}

model Approval {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agentRunId  String?
  agentRun    AgentRun?      @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  workflowRunId String?      // M7-P6: Workflow 审批步骤绑定（与 agentRunId/toolCallId 场景互斥）
  workflowRun  WorkflowRun?  @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  toolCallId  String?
  toolCall    ToolCall?      @relation(fields: [toolCallId], references: [id], onDelete: Cascade)
  waitingRuns AgentRun[]     @relation("RunWaitingApproval")
  externalActions ExternalAction[]
  status      ApprovalStatus @default(requested)
  riskLevel   String         @default("medium") // low | medium | high
  reason      String
  payload     Json?
  expiresAt   DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  @@index([userId, createdAt])
  @@index([projectId])
  @@index([agentRunId])
  @@index([toolCallId])
  @@index([workflowRunId])
  @@index([status, expiresAt])
}

// ===== M7-P2: Connection / OAuth / Credential（统一第三方账号连接体系）=====
enum ConnectionStatus {
  active
  expired
  revoked
}

model Connection {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId    String?          // M8-P1：组织归属
  organization      Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId         String?
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  provider          String           // mock | shopify | amazon | meta_ads | google_ads | tiktok_ads
  providerAccountId String?
  status            ConnectionStatus @default(active)
  scope             Json?
  expiresAt         DateTime?
  revokedAt         DateTime?
  lastSyncedAt      DateTime?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  credentials       Credential[]
  externalActions   ExternalAction[]
  @@index([userId, provider])
  @@index([projectId])
  @@index([userId, provider, providerAccountId])
}

// 凭证：AES-256-GCM 密文 at rest；绝不进 API 响应/DTO/prompt/log
model Credential {
  id             String     @id @default(uuid())
  connectionId   String
  connection     Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  type           String     // access_token | refresh_token
  encryptedValue String
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  @@index([connectionId, type])
}

// OAuth state：single-use、短时（10min）、user+project+provider 绑定
model OAuthState {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  provider  String
  state     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId, createdAt])
}

// ===== M7-P3: External Action（副作用执行的统一审计面；绝不存凭证）=====
enum ExternalActionStatus {
  pending_approval // 审批中（P1 状态机承接）
  executing
  completed
  failed
  cancelled
}

model ExternalAction {
  id                String               @id @default(uuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId    String?              // M8-P1：组织归属（审计/配额归属）
  organization      Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId         String?
  project           Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agentRunId        String?
  agentRun          AgentRun?            @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  toolCallId        String?
  toolCall          ToolCall?            @relation(fields: [toolCallId], references: [id], onDelete: SetNull)
  approvalId        String?
  approval          Approval?            @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  connectionId      String?
  connection        Connection?          @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  provider          String
  actionType        String
  permission        String               // external_action | financial | destructive（执行时快照）
  riskLevel         String               // low | medium | high（分类快照）
  input             Json                 // 业务输入；绝不包含凭证
  status            ExternalActionStatus @default(pending_approval)
  externalRequestId String?              // 远端幂等键（Provider Adapter 侧去重）
  result            Json?
  errorCode         String?
  error             String?
  idempotencyKey    String               // 业务幂等键（同一动作绝不重复执行）
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  @@unique([userId, provider, idempotencyKey])
  @@index([userId, createdAt])
  @@index([agentRunId])
  @@index([approvalId])
  @@index([toolCallId])
}

model AgentRunStep {
  id           String            @id @default(uuid())
  runId        String
  run          AgentRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepIndex    Int
  type         AgentRunStepType
  status       AgentRunStepStatus @default(running)
  input        Json?
  output       Json?
  errorCode    String?
  errorMessage String?
  startedAt    DateTime          @default(now())
  completedAt  DateTime?
  toolCalls    ToolCall[]
  @@unique([runId, stepIndex])
}

model ToolCall {
  id             String         @id @default(uuid())
  runStepId      String
  runStep        AgentRunStep    @relation(fields: [runStepId], references: [id], onDelete: Cascade)
  toolName       String
  idempotencyKey String
  input          Json
  output         Json?
  status         ToolCallStatus @default(running)
  errorCode      String?
  errorMessage   String?
  attempts       Int            @default(1) // M6: 同一行内重试次数（可观测）
  durationMs     Int?
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  tasks          GenerationTask[]
  artifacts      Artifact[]
  approvals      Approval[]
  externalActions ExternalAction[]
  @@unique([runStepId, idempotencyKey])
  @@index([toolName, startedAt])
}

// ===== M6: Agent Run Transcript（LLM 消息持久化，resume 重放唯一输入）=====
// 最小字段判断：role 用字符串（序列本身即协议）；无 message type/status（append-only，终态语义由 run 承担）；
// 无 provider metadata（usage_records 已按回合归因，不重复存）；不存 chain-of-thought（M4 红线延续）。
// assistant 行携带 toolCalls Json 快照（LLM 调用决策事实，resume 不重打 LLM）；tool 行携带 toolCallId（LLM call id）配对。
model AgentRunMessage {
  id         String   @id @default(uuid())
  runId      String
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence   Int
  role       String // system | user | assistant | tool
  content    String   @db.Text
  toolCallId String? // role=tool 时 = LLM 生成的 call id（配对；非 ToolCall 行 id）
  toolCalls  Json?   // role=assistant 时 = tool_calls 数组快照 [{id,name,arguments}]
  createdAt  DateTime @default(now())
  @@unique([runId, sequence])
}

// ===== M5: Agent 版本 =====
enum AgentVersionStatus {
  draft
  published
  archived
}

model AgentVersion {
  id           String             @id @default(uuid())
  agentId      String
  agent        Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  version      Int
  status       AgentVersionStatus @default(draft)
  systemPrompt String             @db.Text
  modelId      String?
  model        Model?             @relation(fields: [modelId], references: [id], onDelete: SetNull)
  tools        Json               @default("[]")
  temperature  Float              @default(0.7)
  maxTokens    Int?
  config       Json?
  createdAt    DateTime           @default(now())
  createdBy    String?
  activeAgent  Agent?            @relation("ActiveVersion")
  runs         AgentRun[]
  @@unique([agentId, version])
}

// ===== M5: Knowledge =====
enum KnowledgeScope {
  user
  project
}
enum KnowledgeBaseStatus {
  active
  disabled
}
enum DocumentSourceType {
  text
  file
}
enum DocumentStatus {
  pending
  processing
  ready
  failed
}

model KnowledgeBase {
  id               String             @id @default(uuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope            KnowledgeScope
  projectId        String?            // scope=project 必填（服务层校验）
  project          Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  embeddingModelId String?
  topK             Int                @default(5)
  scoreThreshold   Float              @default(0.3)
  status           KnowledgeBaseStatus @default(active)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  documents        Document[]
  @@index([userId, scope])
  @@index([projectId])
}

model Document {
  id          String             @id @default(uuid())
  kbId        String?            // 可选分组（KnowledgeBase 为未来组织层，P5 不强制）
  kb          KnowledgeBase?     @relation(fields: [kbId], references: [id], onDelete: SetNull)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?            // 项目归属（project scope 权限）
  project     Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name        String
  sourceType  DocumentSourceType
  content     String?            @db.Text // text 源直存内容
  sourceUri   String?
  storageKey  String?            // file 源文件存储
  mimeType    String?
  sizeBytes   Int?
  contentHash String?            // file 源去重（sha256）
  status      DocumentStatus     @default(pending)
  errorCode   String?
  chunkCount  Int                @default(0)
  version     Int                @default(1)
  metadata    Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  chunks      DocumentChunk[]
  @@unique([kbId, contentHash])
  @@index([userId, projectId])
  @@index([userId, status])
}

model DocumentChunk {
  id             String   @id @default(uuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId         String   // 冗余：权限快路径（SQL 层过滤）
  projectId      String?  // 冗余：project scope 过滤
  chunkIndex     Int
  content        String   @db.Text
  tokenCount     Int      @default(0)
  embedding      Unsupported("vector")?
  embeddingModel String
  createdAt      DateTime @default(now())
  @@unique([documentId, chunkIndex])
  @@index([userId, projectId])
  @@index([documentId])
}

// ===== M7-P4: Commerce（规范化电商数据层；工具集全部 read-only）=====
// 数据管线：External API → Provider Adapter → Normalize → 本层 → Commerce Tool → Agent。
// 当前唯一实现 = MockCommerceAdapter（读本层种子数据）；真实平台适配器留接口位，绝不伪造第三方数据。
model CommerceProduct {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("mock")
  connectionId String?
  externalId   String
  title        String
  description  String?
  price        Float?
  currency     String   @default("CNY")
  status       String   @default("active") // active | draft | archived
  sku          String?
  imageUrl     String?
  inventory    Int?
  category     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([userId, provider, externalId])
  @@index([userId, provider, status])
}

model CommerceOrder {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("mock")
  connectionId String?
  externalId   String
  orderNumber  String
  status       String // pending | paid | fulfilled | cancelled | refunded
  totalAmount  Float
  currency     String   @default("CNY")
  itemCount    Int      @default(0)
  orderedAt    DateTime
  createdAt    DateTime @default(now())
  items        CommerceOrderItem[]
  @@unique([userId, provider, externalId])
  @@index([userId, provider, orderedAt])
  @@index([userId, provider, status])
}

model CommerceOrderItem {
  id         String        @id @default(uuid())
  orderId    String
  order      CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  title      String
  quantity   Int
  unitPrice  Float
  totalPrice Float
  @@index([orderId])
}

// 指标快照（周期 + 维度；服务层按 (period, dimension) 幂等同步，不做强唯一约束）
model CommerceTrafficMetric {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String   @default("mock")
  connectionId   String?
  periodStart    DateTime
  periodEnd      DateTime
  dimension      String   @default("all") // all | source | channel
  dimensionValue String   @default("all")
  impressions    Int      @default(0)
  visits         Int      @default(0)
  uniqueVisitors Int      @default(0)
  @@index([userId, provider, periodStart, dimension, dimensionValue])
}

model CommerceConversionMetric {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String   @default("mock")
  connectionId   String?
  periodStart    DateTime
  periodEnd      DateTime
  dimension      String   @default("all") // all | source | channel
  dimensionValue String   @default("all")
  clicks         Int      @default(0)
  addToCart      Int      @default(0)
  checkouts      Int      @default(0)
  orders         Int      @default(0)
  revenue        Float    @default(0)
  @@index([userId, provider, periodStart, dimension, dimensionValue])
}

model CommerceCampaign {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("mock")
  connectionId String?
  externalId   String
  name         String
  status       String   @default("active") // active | paused | ended
  objective    String?
  budget       Float?
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime @default(now())
  adGroups     CommerceAdGroup[]
  @@unique([userId, provider, externalId])
  @@index([userId, provider, status])
}

model CommerceAdGroup {
  id         String           @id @default(uuid())
  campaignId String
  campaign   CommerceCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  externalId String
  name       String
  status     String           @default("active")
  ads        CommerceAd[]
  @@unique([campaignId, externalId])
}

model CommerceAd {
  id          String           @id @default(uuid())
  adGroupId   String
  adGroup     CommerceAdGroup  @relation(fields: [adGroupId], references: [id], onDelete: Cascade)
  externalId  String
  name        String
  status      String           @default("active") // active | paused
  creativeType String          @default("image") // image | video
  previewUrl  String?
  @@unique([adGroupId, externalId])
}

model CommerceAdMetric {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("mock")
  connectionId String?
  campaignId   String?
  adId         String?
  periodStart  DateTime
  periodEnd    DateTime
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  spend        Float    @default(0)
  conversions  Int      @default(0)
  revenue      Float    @default(0)
  @@index([userId, provider, periodStart, campaignId])
  @@index([userId, provider, periodStart, adId])
}

model CommerceInventoryMetric {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("mock")
  connectionId String?
  productId    String?
  periodStart  DateTime
  periodEnd    DateTime
  stock        Int      @default(0)
  reserved     Int      @default(0)
  sold         Int      @default(0)
  @@index([userId, provider, periodStart, productId])
}

model CommerceRevenueMetric {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("mock")
  connectionId String?
  periodStart  DateTime
  periodEnd    DateTime
  revenue      Float    @default(0)
  orders       Int      @default(0)
  refunds      Float    @default(0)
  netRevenue   Float    @default(0)
  @@index([userId, provider, periodStart])
}

// ===== M7-P5: Commerce Analysis + Creative Brief（事实/推测严格分层）=====
// facts/derived/anomalies = 服务端计算；possibleCauses/recommendations = LLM 推测（独立字段，绝不混入事实）
model CommerceAnalysis {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agentRunId     String?
  agentRun       AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  connectionId   String?
  analysisType   String // sales | traffic | conversion | ads | roas | revenue | inventory | composite
  timeRange      Json
  facts          Json // 原始聚合事实（CommerceService 输出快照）
  derived        Json // 服务端派生指标
  anomalies      Json? // 服务端规则异常（阈值判定，非 LLM）
  possibleCauses Json? // LLM 推测（明确标注 interpretation，绝不当作事实）
  recommendations Json? // LLM 建议（明确标注 recommendation）
  status         String    @default("ready") // draft | ready
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  briefs         CreativeBrief[]
  @@index([userId, createdAt])
  @@index([agentRunId])
}

model CreativeBrief {
  id                 String            @id @default(uuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId          String?
  project            Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agentRunId         String?
  agentRun           AgentRun?         @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  commerceAnalysisId String?
  analysis           CommerceAnalysis? @relation(fields: [commerceAnalysisId], references: [id], onDelete: SetNull)
  problem            String            @db.Text
  target             String?
  objective          String
  creativeAngle      String?
  visualDirection    String?
  copyDirection      String?
  constraints        Json?
  platform           String?
  product            Json? // 商品引用快照（LLM 提供，标注来源）
  evidence           Json? // 数据证据（facts/derived/anomalies 引用快照）
  status             String            @default("draft") // draft | ready | approved | rejected
  artifactId         String? // Artifact(creative_brief) 镜像（与现有制品体系整合）
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  @@index([userId, createdAt])
  @@index([agentRunId])
  @@index([commerceAnalysisId])
}

// ===== M7-P6: Workflow Engine（确定性编排 ≠ Agent 动态推理；复用 M6 lease/waiting/resume/cancel 原语集）=====
enum WorkflowStatus {
  draft
  published
  archived
}

enum WorkflowRunStatus {
  queued
  running
  waiting
  completed
  failed
  cancelled
  timeout
}

enum WorkflowTriggerType {
  manual
  webhook
  schedule
  event
}

model Workflow {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?       // M8-P1：组织归属（创建时由服务端解析；跨组织不可见）
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name        String
  description String?          @db.Text
  status      WorkflowStatus   @default(draft)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  versions    WorkflowVersion[]
  runs        WorkflowRun[]
  webhooks    WorkflowWebhook[]
  @@index([userId, updatedAt])
}

// Version 不可变：每次编辑 = 新版本；Run 锁定 versionId（绝不执行被覆盖的定义）
model WorkflowVersion {
  id         String           @id @default(uuid())
  workflowId String
  workflow   Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version    Int
  status     WorkflowStatus   @default(draft)
  definition Json // { triggers: [...], steps: [...] }
  createdAt  DateTime         @default(now())
  runs       WorkflowRun[]
  @@unique([workflowId, version])
}

model WorkflowRun {
  id                 String            @id @default(uuid())
  workflowId         String
  workflow           Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  versionId          String            // 锁定执行版本（不可变快照）
  version            WorkflowVersion   @relation(fields: [versionId], references: [id], onDelete: Restrict)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId          String?
  triggerType        WorkflowTriggerType
  triggerId          String?           // 触发源（webhook eventId / schedule cron 键 / event 名）
  idempotencyKey     String
  attempt            Int               @default(1)
  status             WorkflowRunStatus @default(queued)
  currentStep        Int               @default(0)
  input              Json?
  output             Json?
  errorCode          String?
  errorMessage       String?
  // M6 原语复用：lease 字段 + waiting 目标（与 AgentRun 同构，独立表）
  workerId           String?
  leaseUntil         DateTime?
  heartbeatAt        DateTime?
  waitingOnApprovalId String?
  waitingOnAgentRunId String? // agent 步骤的子 AgentRun 终态唤醒
  approvals           Approval[]
  startedAt          DateTime          @default(now())
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  steps              WorkflowStepRun[]
  @@index([userId, createdAt])
  @@index([workflowId, createdAt])
  @@index([status])
  @@index([waitingOnApprovalId])
  @@index([waitingOnAgentRunId])
}

model WorkflowStepRun {
  id               String          @id @default(uuid())
  workflowRunId    String
  workflowRun      WorkflowRun     @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  stepId           String          // 定义内 step id
  stepIndex        Int
  stepType         String          // condition | tool | agent | approval | external_action | output
  status           String          @default("queued") // queued | running | waiting | completed | failed | cancelled | skipped
  input            Json?
  output           Json?
  errorCode        String?
  errorMessage     String?
  attempt          Int             @default(0)
  approvalId       String?
  externalActionId String?
  agentRunId       String?         // agent 步骤的子 AgentRun
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  @@unique([workflowRunId, stepIndex])
  @@index([workflowRunId, stepId])
}

// Webhook 触发器（签名/防重放/去重；secret AES-256-GCM at rest，仅校验时服务端解密）
model WorkflowWebhook {
  id               String   @id @default(uuid())
  workflowId       String
  workflow         Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  token            String   @unique // 端点标识（URL 中的随机 token）
  secretEncrypted  String   // HMAC 密钥密文（校验时解密做 timing-safe 比对）
  enabled          Boolean  @default(true)
  lastDeliveredAt  DateTime?
  createdAt        DateTime @default(now())
  deliveries       WebhookDelivery[]
  @@index([workflowId])
}

model WebhookDelivery {
  id          String           @id @default(uuid())
  webhookId   String
  webhook     WorkflowWebhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventId     String           // 防重放：同一 eventId 只接受一次
  payloadHash String
  status      String           @default("accepted") // accepted | duplicate | rejected
  createdAt   DateTime         @default(now())
  @@unique([webhookId, eventId])
}

// ===== M7-P7: Multi-Agent / Delegation（安全委派：深度/子数上限 + 环检测 + 权限子集继承 + 级联取消）=====
model AgentDelegation {
  id                String      @id @default(uuid())
  parentRunId       String
  parentRun         AgentRun    @relation("DelegationParent", fields: [parentRunId], references: [id], onDelete: Cascade)
  delegatedByRunId  String      // 发起委派的 run（直接父；链式 = 各层直接父）
  childRunId        String      @unique
  childRun          AgentRun    @relation("DelegationChild", fields: [childRunId], references: [id], onDelete: Cascade)
  agentId           String      // 子 Agent
  task              String      @db.Text
  idempotencyKey    String      @unique // ToolCall 级幂等：resume 重放绝不产生第二个子 run
  status            String      @default("queued") // queued | running | waiting | completed | failed | cancelled | timeout
  depth             Int         @default(1) // 子 run 的深度（root=0）
  resultSummary     String?     // 结构化结果摘要（终端时写；绝不含内部推理）
  errorCode         String?
  createdAt         DateTime    @default(now())
  completedAt       DateTime?
  @@index([parentRunId])
  @@index([delegatedByRunId])
}

// ===== M7-P8: Feedback / Performance Learning（不改模型权重——经 Memory 闭环）=====
model Feedback {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  subjectType String // artifact | creativeBrief | product | campaign | ad | generationTask | agentRun | analysis
  subjectId   String
  rating      Int // 1~5
  comment     String?  @db.Text
  createdAt   DateTime @default(now())
  @@index([userId, createdAt])
  @@index([subjectType, subjectId])
}

// 创意绩效（发布后回流：原始事实 + 服务端派生；learning 经 Memory 候选闭环）
model CreativePerformance {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  artifactId  String?
  campaignId  String?
  adId        String?
  platform    String   @default("mock")
  periodStart DateTime
  periodEnd   DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spend       Float    @default(0)
  conversions Int      @default(0)
  revenue     Float    @default(0)
  orders      Int      @default(0)
  capturedAt  DateTime @default(now())
  @@index([userId, artifactId])
  @@index([userId, campaignId])
  @@index([userId, periodStart])
}

// 通用绩效快照（多源回流统一层）
model PerformanceSnapshot {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  source      String   @default("mock") // mock | ads | commerce
  periodStart DateTime
  periodEnd   DateTime
  metrics     Json // 结构化指标快照（facts 层，服务端计算）
  capturedAt  DateTime @default(now())
  @@index([userId, periodStart])
  @@index([projectId])
}

// ===== M7-P9: AuditLog（关键行为追踪：who/what/when/which project/run/tool/approval/action）=====
model AuditLog {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?
  action           String // approval.decided | external_action.executed | connection.established | connection.revoked | workflow_run.created | workflow_run.cancelled | delegation.created | webhook.accepted | auth.login
  targetType       String?
  targetId         String?
  agentRunId       String?
  toolCallId       String?
  approvalId       String?
  externalActionId String?
  workflowRunId    String?
  connectionId     String?
  metadata         Json?
  createdAt        DateTime @default(now())
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([agentRunId])
}

// ===== M8-P1: Multi-tenancy / Organization / RBAC =====
enum OrganizationRole {
  owner
  admin
  member
  viewer
}

model Organization {
  id          String                 @id @default(uuid())
  name        String
  slug        String                 @unique
  isPersonal  Boolean                @default(false) // 个人默认组织（每用户一个，backfill + 懒创建）
  ownerUserId String
  deletedAt   DateTime?              // soft delete
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  members     OrganizationMember[]
  invitations OrganizationInvitation[]
  projects    Project[]
  agents      Agent[]
  workflows   Workflow[]
  connections Connection[]
  externalActions ExternalAction[]
  subscription Subscription?
  usageLedger  UsageLedgerEntry[]
  quotaAlerts  QuotaAlert[]
  invoices     Invoice[]
  paymentEvents PaymentEvent[]
  @@index([ownerUserId])
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationRole @default(member)
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationInvitation {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email            String
  role             OrganizationRole @default(member)
  invitedByUserId  String
  token            String       @unique
  status           String       @default("pending") // pending | accepted | revoked | expired
  expiresAt        DateTime
  acceptedByUserId String?
  createdAt        DateTime     @default(now())
  @@index([organizationId, status])
}

// ===== M8-P2: Billing / Subscription / Quota（计量复用 UsageRecord，不建第二套）=====
model Plan {
  id          String   @id @default(uuid())
  code        String   @unique // free | pro | team | enterprise
  name        String
  monthlyPrice Float    @default(0)
  yearlyPrice  Float    @default(0)
  entitlements Json    // { llmTokensMonthly, imageMonthly, videoSecondsMonthly, externalApiMonthly, agentRunsMonthly, workflowRunsMonthly, storageMb, seats }
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  status         String   @default("active") // active | past_due | cancelled | expired
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([organizationId]) // 每组织一个订阅
  @@index([status])
}

model UsageLedgerEntry {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  projectId      String?
  kind           String   // llm_tokens | llm_cost | image_generation | video_seconds | external_api_call | agent_run | workflow_run | storage | seat
  quantity       Float    @default(0)
  unit           String   @default("count")
  runId          String?
  taskId         String?
  toolCallId     String?
  usageRecordId  String?  // 与 UsageRecord 关联（复用既有计量，不重复计费）
  idempotencyKey String   // 幂等：同键绝不重复计量
  period         String   // YYYY-MM（月度归集）
  metadata       Json?
  createdAt      DateTime @default(now())
  @@unique([idempotencyKey])
  @@index([organizationId, period])
  @@index([usageRecordId])
  @@index([runId])
}

model QuotaAlert {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           String   // monthly | daily | concurrent
  quotaKey       String   // llm_tokens | image_generation | ...
  thresholdPct   Int      @default(80)
  lastTriggeredAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([organizationId, kind, quotaKey, thresholdPct])
}

model Invoice {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId String?
  number         String   @unique
  status         String   @default("draft") // draft | open | paid | void
  amount         Float    @default(0)
  currency       String   @default("CNY")
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([organizationId])
}

model PaymentEvent {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String   @default("mock")
  providerEventId String  // 幂等：同 provider event 只入账一次
  type           String   // payment.succeeded | payment.failed | refund
  amount         Float    @default(0)
  currency       String   @default("CNY")
  invoiceId      String?
  metadata       Json?
  createdAt      DateTime @default(now())
  @@unique([provider, providerEventId])
  @@index([organizationId])
}
