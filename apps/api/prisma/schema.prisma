generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL") // 持久 shadow 库（预装 pgvector，重放含 CREATE EXTENSION 的历史迁移所需）
}

// ===== 枚举 =====
enum UserRole {
  user
  admin
}
enum UserStatus {
  active
  disabled
}
enum MessageRole {
  user
  assistant
  system
  tool
}
enum MessageStatus {
  pending
  streaming
  completed
  failed
  cancelled
}
enum IntentType {
  chat
  image_generation
  video_generation
  image_analysis
  file_analysis
  agent_task
  workflow
}
enum AttachmentType {
  image
  video
  file
}
enum AttachmentKind {
  upload
  generated_image
  generated_video
  generated_file
}

// ===== M2 枚举 =====
enum MemoryScope {
  user
  project
}
enum MemoryCategory {
  preference
  profile
  instruction
  project_context
  workflow
  other
}
enum MemoryStatus {
  candidate
  active
  rejected
}
enum ArtifactType {
  creative_brief
  image
  video
  report
  analysis
  other
}
enum ArtifactStatus {
  draft
  ready
  failed
}
enum AttachmentStatus {
  uploading
  ready
  failed
}
enum ProviderType {
  llm
  image
  video
  embedding
}
enum HealthStatus {
  untested
  healthy
  unhealthy
}
enum ModelType {
  llm
  image
  video
  embedding
}
enum TaskType {
  image
  video
}
enum TaskStatus {
  pending
  processing
  completed
  failed
  cancelled
}
enum UsageKind {
  llm_chat
  llm_router
  image
  video
}
enum UsageStatus {
  success
  failed
}

// ===== 用户与认证 =====
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  role         UserRole  @default(user)
  status       UserStatus @default(active)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  conversations Conversation[]
  messages      Message[]
  attachments   Attachment[]
  tasks         GenerationTask[]
  usages        UsageRecord[]
  sessions      Session[]
  projects      Project[]
  memories      Memory[]
  artifacts     Artifact[]
  agentRuns     AgentRun[]
  approvals     Approval[]
  connections   Connection[]
  oauthStates   OAuthState[]
  externalActions ExternalAction[]
  commerceProducts    CommerceProduct[]
  commerceOrders      CommerceOrder[]
  commerceTraffic     CommerceTrafficMetric[]
  commerceConversions CommerceConversionMetric[]
  commerceCampaigns   CommerceCampaign[]
  commerceAdMetrics   CommerceAdMetric[]
  commerceInventory   CommerceInventoryMetric[]
  commerceRevenue     CommerceRevenueMetric[]
  commerceAnalyses  CommerceAnalysis[]
  creativeBriefs    CreativeBrief[]
  workflows         Workflow[]
  workflowRuns      WorkflowRun[]
  feedbacks         Feedback[]
  creativePerformances CreativePerformance[]
  performanceSnapshots PerformanceSnapshot[]
  auditLogs         AuditLog[]
  organizationMemberships OrganizationMember[]
  scheduledJobs       ScheduledJob[]
  extensions          Extension[]
  knowledgeBases KnowledgeBase[]
  documents      Document[]
  memoryCandidates MemoryCandidate[]
  creativeHypotheses CreativeHypothesis[] // M10-P4
  creativeInsights CreativeInsight[]       // M10-P4
  evaluationDatasets EvaluationDataset[]
  evaluationRuns EvaluationRun[]
  evaluators Evaluator[]
  experiments Experiment[]
  extensionPublications ExtensionPublication[]
  extensionReviews ExtensionReview[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  @@index([userId])
}

// ===== 对话 =====
model Conversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title     String   @default("新对话")
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  Message[]
  summaries ConversationSummary[]
  artifacts Artifact[]
  agentRuns AgentRun[]
  @@index([userId, deletedAt, updatedAt(sort: Desc), id(sort: Desc)]) // M10-P16：会话列表游标分页（替换旧 [userId, updatedAt]）
  @@index([projectId])
}

model Message {
  id               String          @id @default(uuid())
  conversationId   String
  conversation     Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  role             MessageRole
  content          String          @db.Text
  intentType       IntentType?
  intentConfidence Float?
  agentId          String?
  agent            Agent?          @relation(fields: [agentId], references: [id])
  modelId          String?
  status           MessageStatus   @default(completed)
  errorCode        String?
  tokenUsage       Json?
  editedAt         DateTime?       // M10-P3：用户编辑时间（仅本人 user 消息可编辑；null = 未编辑）
  createdAt        DateTime        @default(now())
  attachments      Attachment[]
  tasks            GenerationTask[]
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)]) // M10-P16：游标分页 keyset+Sort 消除（替换旧 2 列索引）
}

// ===== 附件（上传与生成产物统一管理）=====
model Attachment {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  conversationId  String?
  messageId       String?
  message         Message?         @relation(fields: [messageId], references: [id])
  kind            AttachmentKind
  type            AttachmentType
  mimeType        String
  storageKey      String
  storageProvider String           @default("local")
  originalName    String?
  sizeBytes       Int
  metadata        Json?
  status          AttachmentStatus @default(ready)
  taskId          String?
  task            GenerationTask?  @relation(fields: [taskId], references: [id])
  createdAt       DateTime         @default(now())
  @@index([userId, createdAt])
  @@index([messageId])
}

// ===== Agent =====
model Agent {
  id              String    @id @default(uuid())
  slug            String    @unique
  name            String
  description     String?
  enabled         Boolean   @default(true)
  priority        Int       @default(100)
  builtin         Boolean   @default(false)
  kind            String    @default("builtin") // builtin(代码类) | custom(纯 prompt 配置)
  scope           String    @default("system") // system | organization | user
  organizationId  String?   // M8-P1：scope=organization 时必填
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  activeVersionId String?   @unique
  activeVersion   AgentVersion? @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messages        Message[]
  runs            AgentRun[]
  versions        AgentVersion[]
}

// ===== Provider 与模型 =====
model Provider {
  id              String       @id @default(uuid())
  name            String
  type            ProviderType
  adapter         String
  baseUrl         String
  apiKeyEncrypted String       @default("")
  enabled         Boolean      @default(false)
  priority        Int          @default(100)
  timeoutMs       Int          @default(60000)
  retryConfig     Json?
  healthStatus    HealthStatus @default(untested)
  health          Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  models          Model[]
  tasks           GenerationTask[]
  usages          UsageRecord[]
  @@index([type, enabled])
}

model Model {
  id            String     @id @default(uuid())
  providerId    String
  provider      Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name          String
  apiModelId    String
  type          ModelType
  capabilities  Json?
  inputPrice    Float      @default(0)
  outputPrice   Float      @default(0)
  unitPrice     Float      @default(0)
  contextWindow Int?
  enabled       Boolean    @default(true)
  priority      Int        @default(100)
  isDefault     Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  agentVersions AgentVersion[]
  tasks         GenerationTask[]
  usages        UsageRecord[]
  @@index([type, enabled])
}

// ===== 生成任务 =====
model GenerationTask {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  conversationId String?
  messageId      String?
  message        Message?    @relation(fields: [messageId], references: [id])
  type           TaskType
  providerId     String?
  provider       Provider?   @relation(fields: [providerId], references: [id])
  modelId        String?
  model          Model?      @relation(fields: [modelId], references: [id])
  status         TaskStatus  @default(pending)
  progress       Int?
  statusMessage  String?
  input          Json
  output         Json?
  remoteTaskId   String?
  errorCode      String?
  errorMessage   String?
  attempts       Int         @default(0)
  idempotencyKey String?     @unique
  runId          String?     // AgentRun 追溯（非 Agent 场景为 null）
  run            AgentRun?   @relation(fields: [runId], references: [id], onDelete: Restrict)
  toolCallId     String?     // ToolCall 追溯（非 Agent 场景为 null）
  toolCall       ToolCall?   @relation(fields: [toolCallId], references: [id], onDelete: Restrict)
  costEstimate   Float?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  attachments    Attachment[]
  @@index([userId, createdAt])
  @@index([status])
  @@index([runId])
  @@index([toolCallId])
  @@index([conversationId, createdAt(sort: Desc)]) // M10-P16：任务列表端点（原全表扫）
}

// ===== 用量与成本 =====
model UsageRecord {
  id             String      @id @default(uuid())
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  organizationId String      // Pre-M9 T1：组织归属必填（写入时从 run/project/user 事实链解析；事实不可无主）
  organization   Organization @relation(fields: [organizationId], references: [id])
  conversationId String?
  messageId      String?
  taskId         String?
  runId          String?
  providerId     String?
  provider       Provider?   @relation(fields: [providerId], references: [id])
  modelId        String?
  model          Model?      @relation(fields: [modelId], references: [id])
  kind           UsageKind
  inputTokens    Int         @default(0)
  outputTokens   Int         @default(0)
  imageCount     Int         @default(0)
  videoSeconds   Int         @default(0)
  latencyMs      Int?
  estimatedCost  Float       @default(0)
  status         UsageStatus @default(success)
  errorCode      String?
  createdAt      DateTime    @default(now())
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([runId])
  @@index([organizationId, createdAt])
  @@index([providerId, createdAt]) // M10-P16：路由健康评分窗口聚合（原每次路由决策全表扫）
}

// ===== 系统配置 =====
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ===== M2: Project =====
model Project {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?      // M8-P1：项目必须属于组织（存量 backfill 后服务层新建必填；nullable 为历史兼容）
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name          String
  description   String?      @db.Text
  metadata      Json?
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  conversations Conversation[]
  memories      Memory[]
  artifacts     Artifact[]
  agentRuns     AgentRun[]
  approvals     Approval[]
  connections   Connection[]
  externalActions ExternalAction[]
  commerceAnalyses CommerceAnalysis[]
  creativeBriefs   CreativeBrief[]
  workflows        Workflow[]
  knowledgeBases KnowledgeBase[]
  documents       Document[]
  memoryCandidates MemoryCandidate[]
  creativeHypotheses CreativeHypothesis[] // M10-P4
  creativeInsights CreativeInsight[]       // M10-P4
  @@index([userId, updatedAt])
  @@index([organizationId])
}

// ===== M2: Memory（单表，scope 区分 user/project）=====
// confidence：AI 判断"这是否值得保存"的置信度（提取时，0~1）
// importance：该记忆对未来任务的重要程度（0~100，ContextAssembler 读取排序用）
// 两者是不同概念，不合并。
model Memory {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope           MemoryScope
  projectId       String?        // scope=project 时必填（服务层校验）
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content         String         @db.Text
  category        MemoryCategory
  source          String?        // manual | extractor | assistant
  sourceMessageId String?
  importance      Int            @default(50) // 0~100
  confidence      Float?                       // 提取置信度（candidate 阶段）
  status          MemoryStatus   @default(candidate)
  lastUsedAt      DateTime?                    // 最近一次被上下文组装使用（暂不参与排序，供统计/淘汰预留）
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  @@index([userId, scope, status])
  @@index([projectId, scope, status])
}

// ===== M2: ConversationSummary（仅结构，M6 自动摘要）=====
model ConversationSummary {
  id                        String       @id @default(uuid())
  conversationId            String
  conversation              Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  summary                   String       @db.Text
  summarizedThroughMessageId String?
  // ===== M9-P2 Advanced Memory：增量摘要版本链（每会话多行；消息 id 锚定来源区间）=====
  sourceStartMessageId      String?      // 本段摘要覆盖的第一条消息（不含即从头）
  sourceEndMessageId        String?      // 覆盖的最后一条消息（增量链的拼接锚点）
  tokenCount                Int          @default(0)
  parentSummaryId           String?      // 版本链：本段摘要在前版基础上增量生成
  parentSummary             ConversationSummary? @relation("SummaryChain", fields: [parentSummaryId], references: [id], onDelete: SetNull)
  children                  ConversationSummary[] @relation("SummaryChain")
  stale                     Boolean      @default(false) // 覆盖区间内消息被编辑/删除 → 待重算
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  @@index([conversationId, createdAt])
}

// ===== M2: Artifact（制品层，仅结构，不做 Workflow）=====
model Artifact {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId      String?
  taskId         String?
  runId          String?        // AgentRun 追溯（非 Agent 场景为 null）
  run            AgentRun?      @relation(fields: [runId], references: [id], onDelete: Restrict)
  toolCallId     String?        // ToolCall 追溯（非 Agent 场景为 null）
  toolCall       ToolCall?      @relation(fields: [toolCallId], references: [id], onDelete: Restrict)
  type           ArtifactType
  title          String
  summary        String?        @db.Text
  content        Json?
  storageKey     String?
  idempotencyKey String?        // M6: resume 重放去重（部分唯一索引，见 migration）
  status         ArtifactStatus @default(ready)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  @@index([userId, createdAt])
  @@index([projectId])
  @@index([conversationId])
  @@index([runId])
  @@index([toolCallId])
}

// ===== M4: Agent 执行 =====
enum AgentRunStatus {
  queued
  running
  waiting // M6: run 存活但无 worker，等待外部异步任务（GenerationTask）完成
  completed
  failed
  cancelled
  timeout
}
enum AgentRunStepType {
  reasoning
  tool_call
  tool_result
  final
}
enum AgentRunStepStatus {
  running
  completed
  failed
  cancelled
}
enum ToolCallStatus {
  running
  completed
  failed
  waiting_approval // M7-P1: 等待人工审批（Approval 决定后 resume 继续执行或失败回喂）
}

model AgentRun {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent          @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentVersionId String?
  agentVersion   AgentVersion?  @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status         AgentRunStatus @default(running)
  currentStep    Int            @default(0)
  maxSteps       Int            @default(8)
  errorCode      String?
  errorMessage   String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  // ===== M6: Long-running Agent Runtime（P1 数据层；claim/renew/recover 逻辑 P3 实现）=====
  workerId        String?      // lease 持有者（worker 实例 id）；NULL = 同步 run（M5 语义，sweep 沿用 120s）
  leaseUntil      DateTime?    // 租约到期时刻（心跳续期）
  heartbeatAt     DateTime?    // 最近心跳（可观测）
  waitingOnTaskId     String?      // waiting 时等待的 GenerationTask
  waitingOnApprovalId String?      // M7-P1: waiting 时等待的 Approval（与 waitingOnTaskId 互斥）
  waitingOnApproval   Approval?    @relation("RunWaitingApproval", fields: [waitingOnApprovalId], references: [id], onDelete: SetNull)
  externalActions     ExternalAction[]
  approvals           Approval[]   // 本 run 产生的审批
  commerceAnalyses    CommerceAnalysis[]
  creativeBriefs      CreativeBrief[]
  // ===== M7-P7: 委派血缘（父/发起者/深度；child 权限 ⊆ parent 权限由服务层保证）=====
  parentRunId         String?
  parentRun           AgentRun?   @relation("DelegationParent", fields: [parentRunId], references: [id], onDelete: SetNull)
  children            AgentRun[]  @relation("DelegationParent")
  delegatedByRunId    String?     // 发起委派的 run（直接父）
  depth               Int         @default(0) // root=0；每层委派 +1（上限 limits.delegationMaxDepth）
  waitingOnDelegationId String?   // waiting 时等待的 AgentDelegation（子 run 终态唤醒）
  delegationsAsParent AgentDelegation[] @relation("DelegationParent")
  delegationsAsChild  AgentDelegation[] @relation("DelegationChild")
  retryOfRunId    String?      // Retry = 新 Run 血缘（不重新打开 terminal run）
  retryOf         AgentRun?  @relation("RetryChain", fields: [retryOfRunId], references: [id], onDelete: SetNull)
  retries         AgentRun[] @relation("RetryChain")
  attempt         Int          @default(1)
  steps          AgentRunStep[]
  tasks          GenerationTask[]
  artifacts      Artifact[]
  messages       AgentRunMessage[]
  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([status, leaseUntil])
  @@index([retryOfRunId])
  @@index([waitingOnTaskId])
  @@index([waitingOnApprovalId])
  @@index([parentRunId])
  @@index([delegatedByRunId])
  @@index([waitingOnDelegationId])
}

// ===== M7-P1: Approval（Human-in-the-loop；M6 waiting 的第二种等待目标）=====
enum ApprovalStatus {
  requested
  approved
  rejected
  expired
  cancelled
}

model Approval {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agentRunId  String?
  agentRun    AgentRun?      @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  workflowRunId String?      // M7-P6: Workflow 审批步骤绑定（与 agentRunId/toolCallId 场景互斥）
  workflowRun  WorkflowRun?  @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  toolCallId  String?
  toolCall    ToolCall?      @relation(fields: [toolCallId], references: [id], onDelete: Cascade)
  waitingRuns AgentRun[]     @relation("RunWaitingApproval")
  externalActions ExternalAction[]
  status      ApprovalStatus @default(requested)
  riskLevel   String         @default("medium") // low | medium | high
  reason      String
  payload     Json?
  expiresAt   DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  @@index([userId, createdAt])
  @@index([projectId])
  @@index([agentRunId])
  @@index([toolCallId])
  @@index([workflowRunId])
  @@index([status, expiresAt])
}

// ===== M7-P2: Connection / OAuth / Credential（统一第三方账号连接体系）=====
enum ConnectionStatus {
  active
  expired
  revoked
}

model Connection {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId    String?          // M8-P1：组织归属
  organization      Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId         String?
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  provider          String           // mock | shopify | amazon | meta_ads | google_ads | tiktok_ads
  providerAccountId String?
  status            ConnectionStatus @default(active)
  scope             Json?
  expiresAt         DateTime?
  revokedAt         DateTime?
  lastSyncedAt      DateTime?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  credentials       Credential[]
  externalActions   ExternalAction[]
  @@index([userId, provider])
  @@index([projectId])
  @@index([userId, provider, providerAccountId])
}

// 凭证：AES-256-GCM 密文 at rest；绝不进 API 响应/DTO/prompt/log
model Credential {
  id             String     @id @default(uuid())
  connectionId   String
  connection     Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  type           String     // access_token | refresh_token
  encryptedValue String
  keyVersion     Int        @default(1) // M10-P1：加密密钥版本（轮换后 rewrap 迁移；绝不静默混用）
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  @@index([connectionId, type])
}

// OAuth state：single-use、短时（10min）、user+project+provider 绑定
model OAuthState {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  provider  String
  state     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId, createdAt])
}

// ===== M7-P3: External Action（副作用执行的统一审计面；绝不存凭证）=====
enum ExternalActionStatus {
  pending_approval // 审批中（P1 状态机承接）
  executing
  completed
  failed
  cancelled
}

model ExternalAction {
  id                String               @id @default(uuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId    String?              // M8-P1：组织归属（审计/配额归属）
  organization      Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId         String?
  project           Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agentRunId        String?
  agentRun          AgentRun?            @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  toolCallId        String?
  toolCall          ToolCall?            @relation(fields: [toolCallId], references: [id], onDelete: SetNull)
  approvalId        String?
  approval          Approval?            @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  connectionId      String?
  connection        Connection?          @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  provider          String
  actionType        String
  permission        String               // external_action | financial | destructive（执行时快照）
  riskLevel         String               // low | medium | high（分类快照）
  input             Json                 // 业务输入；绝不包含凭证
  status            ExternalActionStatus @default(pending_approval)
  externalRequestId String?              // 远端幂等键（Provider Adapter 侧去重）
  result            Json?
  errorCode         String?
  error             String?
  idempotencyKey    String               // 业务幂等键（同一动作绝不重复执行）
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  @@unique([userId, provider, idempotencyKey])
  @@index([userId, createdAt])
  @@index([agentRunId])
  @@index([approvalId])
  @@index([toolCallId])
}

model AgentRunStep {
  id           String            @id @default(uuid())
  runId        String
  run          AgentRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepIndex    Int
  type         AgentRunStepType
  status       AgentRunStepStatus @default(running)
  input        Json?
  output       Json?
  errorCode    String?
  errorMessage String?
  startedAt    DateTime          @default(now())
  completedAt  DateTime?
  toolCalls    ToolCall[]
  @@unique([runId, stepIndex])
}

model ToolCall {
  id             String         @id @default(uuid())
  runStepId      String
  runStep        AgentRunStep    @relation(fields: [runStepId], references: [id], onDelete: Cascade)
  toolName       String
  idempotencyKey String
  input          Json
  output         Json?
  status         ToolCallStatus @default(running)
  errorCode      String?
  errorMessage   String?
  attempts       Int            @default(1) // M6: 同一行内重试次数（可观测）
  durationMs     Int?
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  tasks          GenerationTask[]
  artifacts      Artifact[]
  approvals      Approval[]
  externalActions ExternalAction[]
  @@unique([runStepId, idempotencyKey])
  @@index([toolName, startedAt])
}

// ===== M6: Agent Run Transcript（LLM 消息持久化，resume 重放唯一输入）=====
// 最小字段判断：role 用字符串（序列本身即协议）；无 message type/status（append-only，终态语义由 run 承担）；
// 无 provider metadata（usage_records 已按回合归因，不重复存）；不存 chain-of-thought（M4 红线延续）。
// assistant 行携带 toolCalls Json 快照（LLM 调用决策事实，resume 不重打 LLM）；tool 行携带 toolCallId（LLM call id）配对。
model AgentRunMessage {
  id         String   @id @default(uuid())
  runId      String
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence   Int
  role       String // system | user | assistant | tool
  content    String   @db.Text
  toolCallId String? // role=tool 时 = LLM 生成的 call id（配对；非 ToolCall 行 id）
  toolCalls  Json?   // role=assistant 时 = tool_calls 数组快照 [{id,name,arguments}]
  createdAt  DateTime @default(now())
  @@unique([runId, sequence])
}

// ===== M5: Agent 版本 =====
enum AgentVersionStatus {
  draft
  published
  archived
}

model AgentVersion {
  id           String             @id @default(uuid())
  agentId      String
  agent        Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  version      Int
  status       AgentVersionStatus @default(draft)
  systemPrompt String             @db.Text
  modelId      String?
  model        Model?             @relation(fields: [modelId], references: [id], onDelete: SetNull)
  tools        Json               @default("[]")
  temperature  Float              @default(0.7)
  maxTokens    Int?
  config       Json?
  createdAt    DateTime           @default(now())
  createdBy    String?
  activeAgent  Agent?            @relation("ActiveVersion")
  runs         AgentRun[]
  @@unique([agentId, version])
}

// ===== M5: Knowledge =====
enum KnowledgeScope {
  user
  project
}
enum KnowledgeBaseStatus {
  active
  disabled
}
enum DocumentSourceType {
  text
  file
}
enum DocumentStatus {
  pending
  processing
  ready
  failed
}

model KnowledgeBase {
  id               String             @id @default(uuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope            KnowledgeScope
  projectId        String?            // scope=project 必填（服务层校验）
  project          Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  embeddingModelId String?
  topK             Int                @default(5)
  scoreThreshold   Float              @default(0.3)
  status           KnowledgeBaseStatus @default(active)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  documents        Document[]
  @@index([userId, scope])
  @@index([projectId])
}

model Document {
  id          String             @id @default(uuid())
  kbId        String?            // 可选分组（KnowledgeBase 为未来组织层，P5 不强制）
  kb          KnowledgeBase?     @relation(fields: [kbId], references: [id], onDelete: SetNull)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?            // 项目归属（project scope 权限）
  project     Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name        String
  sourceType  DocumentSourceType
  content     String?            @db.Text // text 源直存内容
  sourceUri   String?
  storageKey  String?            // file 源文件存储
  mimeType    String?
  sizeBytes   Int?
  contentHash String?            // file 源去重（sha256）
  status      DocumentStatus     @default(pending)
  errorCode   String?
  chunkCount  Int                @default(0)
  version     Int                @default(1)
  metadata    Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  chunks      DocumentChunk[]
  @@unique([kbId, contentHash])
  @@index([userId, projectId])
  @@index([userId, status])
}

model DocumentChunk {
  id             String   @id @default(uuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId         String   // 冗余：权限快路径（SQL 层过滤）
  projectId      String?  // 冗余：project scope 过滤
  chunkIndex     Int
  content        String   @db.Text
  tokenCount     Int      @default(0)
  embedding      Unsupported("vector")?
  embeddingModel String
  createdAt      DateTime @default(now())
  @@unique([documentId, chunkIndex])
  @@index([userId, projectId])
  @@index([documentId])
}

// ===== M7-P4: Commerce（规范化电商数据层；工具集全部 read-only）=====
// 数据管线：External API → Provider Adapter → Normalize → 本层 → Commerce Tool → Agent。
// 当前唯一实现 = MockCommerceAdapter（读本层种子数据）；真实平台适配器留接口位，绝不伪造第三方数据。
model CommerceProduct {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("mock")
  connectionId String?
  externalId   String
  title        String
  description  String?
  price        Float?
  currency     String   @default("CNY")
  status       String   @default("active") // active | draft | archived
  sku          String?
  imageUrl     String?
  inventory    Int?
  category     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([userId, provider, externalId])
  @@index([userId, provider, status])
}

model CommerceOrder {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("mock")
  connectionId String?
  externalId   String
  orderNumber  String
  status       String // pending | paid | fulfilled | cancelled | refunded
  totalAmount  Float
  currency     String   @default("CNY")
  itemCount    Int      @default(0)
  orderedAt    DateTime
  createdAt    DateTime @default(now())
  items        CommerceOrderItem[]
  @@unique([userId, provider, externalId])
  @@index([userId, provider, orderedAt])
  @@index([userId, provider, status])
}

model CommerceOrderItem {
  id         String        @id @default(uuid())
  orderId    String
  order      CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  title      String
  quantity   Int
  unitPrice  Float
  totalPrice Float
  @@index([orderId])
}

// 指标快照（周期 + 维度；服务层按 (period, dimension) 幂等同步，不做强唯一约束）
model CommerceTrafficMetric {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String   @default("mock")
  connectionId   String?
  periodStart    DateTime
  periodEnd      DateTime
  dimension      String   @default("all") // all | source | channel
  dimensionValue String   @default("all")
  impressions    Int      @default(0)
  visits         Int      @default(0)
  uniqueVisitors Int      @default(0)
  @@index([userId, provider, periodStart, dimension, dimensionValue])
}

model CommerceConversionMetric {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String   @default("mock")
  connectionId   String?
  periodStart    DateTime
  periodEnd      DateTime
  dimension      String   @default("all") // all | source | channel
  dimensionValue String   @default("all")
  clicks         Int      @default(0)
  addToCart      Int      @default(0)
  checkouts      Int      @default(0)
  orders         Int      @default(0)
  revenue        Float    @default(0)
  @@index([userId, provider, periodStart, dimension, dimensionValue])
}

model CommerceCampaign {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("mock")
  connectionId String?
  externalId   String
  name         String
  status       String   @default("active") // active | paused | ended
  objective    String?
  budget       Float?
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime @default(now())
  adGroups     CommerceAdGroup[]
  @@unique([userId, provider, externalId])
  @@index([userId, provider, status])
}

model CommerceAdGroup {
  id         String           @id @default(uuid())
  campaignId String
  campaign   CommerceCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  externalId String
  name       String
  status     String           @default("active")
  ads        CommerceAd[]
  @@unique([campaignId, externalId])
}

model CommerceAd {
  id          String           @id @default(uuid())
  adGroupId   String
  adGroup     CommerceAdGroup  @relation(fields: [adGroupId], references: [id], onDelete: Cascade)
  externalId  String
  name        String
  status      String           @default("active") // active | paused
  creativeType String          @default("image") // image | video
  previewUrl  String?
  @@unique([adGroupId, externalId])
}

model CommerceAdMetric {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("mock")
  connectionId String?
  campaignId   String?
  adId         String?
  periodStart  DateTime
  periodEnd    DateTime
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  spend        Float    @default(0)
  conversions  Int      @default(0)
  revenue      Float    @default(0)
  @@index([userId, provider, periodStart, campaignId])
  @@index([userId, provider, periodStart, adId])
}

model CommerceInventoryMetric {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("mock")
  connectionId String?
  productId    String?
  periodStart  DateTime
  periodEnd    DateTime
  stock        Int      @default(0)
  reserved     Int      @default(0)
  sold         Int      @default(0)
  @@index([userId, provider, periodStart, productId])
}

model CommerceRevenueMetric {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("mock")
  connectionId String?
  periodStart  DateTime
  periodEnd    DateTime
  revenue      Float    @default(0)
  orders       Int      @default(0)
  refunds      Float    @default(0)
  netRevenue   Float    @default(0)
  @@index([userId, provider, periodStart])
}

// ===== M7-P5: Commerce Analysis + Creative Brief（事实/推测严格分层）=====
// facts/derived/anomalies = 服务端计算；possibleCauses/recommendations = LLM 推测（独立字段，绝不混入事实）
model CommerceAnalysis {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agentRunId     String?
  agentRun       AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  connectionId   String?
  analysisType   String // sales | traffic | conversion | ads | roas | revenue | inventory | composite
  timeRange      Json
  facts          Json // 原始聚合事实（CommerceService 输出快照）
  derived        Json // 服务端派生指标
  anomalies      Json? // 服务端规则异常（阈值判定，非 LLM）
  possibleCauses Json? // LLM 推测（明确标注 interpretation，绝不当作事实）
  recommendations Json? // LLM 建议（明确标注 recommendation）
  status         String    @default("ready") // draft | ready
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  briefs         CreativeBrief[]
  @@index([userId, createdAt])
  @@index([agentRunId])
}

model CreativeBrief {
  id                 String            @id @default(uuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId          String?
  project            Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agentRunId         String?
  agentRun           AgentRun?         @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  commerceAnalysisId String?
  analysis           CommerceAnalysis? @relation(fields: [commerceAnalysisId], references: [id], onDelete: SetNull)
  problem            String            @db.Text
  target             String?
  objective          String
  creativeAngle      String?
  visualDirection    String?
  copyDirection      String?
  constraints        Json?
  platform           String?
  product            Json? // 商品引用快照（LLM 提供，标注来源）
  evidence           Json? // 数据证据（facts/derived/anomalies 引用快照）
  status             String            @default("draft") // draft | ready | approved | rejected
  artifactId         String? // Artifact(creative_brief) 镜像（与现有制品体系整合）
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  @@index([userId, createdAt])
  @@index([agentRunId])
  @@index([commerceAnalysisId])
}

// ===== M7-P6: Workflow Engine（确定性编排 ≠ Agent 动态推理；复用 M6 lease/waiting/resume/cancel 原语集）=====
enum WorkflowStatus {
  draft
  published
  archived
}

enum WorkflowRunStatus {
  queued
  running
  waiting
  completed
  failed
  cancelled
  timeout
}

enum WorkflowTriggerType {
  manual
  webhook
  schedule
  event
}

model Workflow {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?       // M8-P1：组织归属（创建时由服务端解析；跨组织不可见）
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name        String
  description String?          @db.Text
  status      WorkflowStatus   @default(draft)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  versions    WorkflowVersion[]
  runs        WorkflowRun[]
  webhooks    WorkflowWebhook[]
  @@index([userId, updatedAt])
}

// Version 不可变：每次编辑 = 新版本；Run 锁定 versionId（绝不执行被覆盖的定义）
model WorkflowVersion {
  id         String           @id @default(uuid())
  workflowId String
  workflow   Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version    Int
  status     WorkflowStatus   @default(draft)
  definition Json // { triggers: [...], steps: [...] }
  createdAt  DateTime         @default(now())
  runs       WorkflowRun[]
  @@unique([workflowId, version])
}

model WorkflowRun {
  id                 String            @id @default(uuid())
  workflowId         String
  workflow           Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  versionId          String            // 锁定执行版本（不可变快照）
  version            WorkflowVersion   @relation(fields: [versionId], references: [id], onDelete: Restrict)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId          String?
  triggerType        WorkflowTriggerType
  triggerId          String?           // 触发源（webhook eventId / schedule cron 键 / event 名）
  idempotencyKey     String
  attempt            Int               @default(1)
  status             WorkflowRunStatus @default(queued)
  currentStep        Int               @default(0)
  input              Json?
  output             Json?
  errorCode          String?
  errorMessage       String?
  // M6 原语复用：lease 字段 + waiting 目标（与 AgentRun 同构，独立表）
  workerId           String?
  leaseUntil         DateTime?
  heartbeatAt        DateTime?
  waitingOnApprovalId String?
  waitingOnAgentRunId String? // agent 步骤的子 AgentRun 终态唤醒
  definitionSnapshot  Json?   // M10-P5：run 创建时锁定定义快照（真实快照；为 null 的历史 run 读 version 行兜底）
  approvals           Approval[]
  startedAt          DateTime          @default(now())
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  steps              WorkflowStepRun[]
  @@index([userId, createdAt])
  @@index([workflowId, createdAt])
  @@index([status])
  @@index([waitingOnApprovalId])
  @@index([waitingOnAgentRunId])
}

model WorkflowStepRun {
  id               String          @id @default(uuid())
  workflowRunId    String
  workflowRun      WorkflowRun     @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  stepId           String          // 定义内 step id
  stepIndex        Int
  stepType         String          // condition | tool | agent | approval | external_action | output
  status           String          @default("queued") // queued | running | waiting | completed | failed | cancelled | skipped
  input            Json?
  output           Json?
  errorCode        String?
  errorMessage     String?
  attempt          Int             @default(0)
  approvalId       String?
  externalActionId String?
  agentRunId       String?         // agent 步骤的子 AgentRun
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  @@unique([workflowRunId, stepIndex])
  @@index([workflowRunId, stepId])
}

// Webhook 触发器（签名/防重放/去重；secret AES-256-GCM at rest，仅校验时服务端解密）
model WorkflowWebhook {
  id               String   @id @default(uuid())
  workflowId       String
  workflow         Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  token            String   @unique // 端点标识（URL 中的随机 token）
  secretEncrypted  String   // HMAC 密钥密文（校验时解密做 timing-safe 比对）
  enabled          Boolean  @default(true)
  lastDeliveredAt  DateTime?
  createdAt        DateTime @default(now())
  deliveries       WebhookDelivery[]
  @@index([workflowId])
}

model WebhookDelivery {
  id          String           @id @default(uuid())
  webhookId   String
  webhook     WorkflowWebhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventId     String           // 防重放：同一 eventId 只接受一次
  payloadHash String
  status      String           @default("accepted") // accepted | duplicate | rejected
  createdAt   DateTime         @default(now())
  @@unique([webhookId, eventId])
}

// ===== M7-P7: Multi-Agent / Delegation（安全委派：深度/子数上限 + 环检测 + 权限子集继承 + 级联取消）=====
model AgentDelegation {
  id                String      @id @default(uuid())
  parentRunId       String
  parentRun         AgentRun    @relation("DelegationParent", fields: [parentRunId], references: [id], onDelete: Cascade)
  delegatedByRunId  String      // 发起委派的 run（直接父；链式 = 各层直接父）
  childRunId        String      @unique
  childRun          AgentRun    @relation("DelegationChild", fields: [childRunId], references: [id], onDelete: Cascade)
  agentId           String      // 子 Agent
  task              String      @db.Text
  idempotencyKey    String      @unique // ToolCall 级幂等：resume 重放绝不产生第二个子 run
  status            String      @default("queued") // queued | running | waiting | completed | failed | cancelled | timeout
  depth             Int         @default(1) // 子 run 的深度（root=0）
  resultSummary     String?     // 结构化结果摘要（终端时写；绝不含内部推理）
  errorCode         String?
  createdAt         DateTime    @default(now())
  completedAt       DateTime?
  @@index([parentRunId])
  @@index([delegatedByRunId])
}

// ===== M7-P8: Feedback / Performance Learning（不改模型权重——经 Memory 闭环）=====
model Feedback {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  subjectType String // artifact | creativeBrief | product | campaign | ad | generationTask | agentRun | analysis
  subjectId   String
  rating      Int // 1~5
  comment     String?  @db.Text
  createdAt   DateTime @default(now())
  @@index([userId, createdAt])
  @@index([subjectType, subjectId])
}

// 创意绩效（发布后回流：原始事实 + 服务端派生；learning 经 Memory 候选闭环）
model CreativePerformance {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  artifactId  String?
  campaignId  String?
  adId        String?
  platform    String   @default("mock")
  periodStart DateTime
  periodEnd   DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spend       Float    @default(0)
  conversions Int      @default(0)
  revenue     Float    @default(0)
  orders      Int      @default(0)
  capturedAt  DateTime @default(now())
  @@index([userId, artifactId])
  @@index([userId, campaignId])
  @@index([userId, periodStart])
}

// 通用绩效快照（多源回流统一层）
model PerformanceSnapshot {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  source      String   @default("mock") // mock | ads | commerce
  periodStart DateTime
  periodEnd   DateTime
  metrics     Json // 结构化指标快照（facts 层，服务端计算）
  capturedAt  DateTime @default(now())
  @@index([userId, periodStart])
  @@index([projectId])
}

// ===== M7-P9: AuditLog（关键行为追踪：who/what/when/which project/run/tool/approval/action）=====
model AuditLog {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?
  action           String // approval.decided | external_action.executed | connection.established | connection.revoked | workflow_run.created | workflow_run.cancelled | delegation.created | webhook.accepted | auth.login
  targetType       String?
  targetId         String?
  agentRunId       String?
  toolCallId       String?
  approvalId       String?
  externalActionId String?
  workflowRunId    String?
  connectionId     String?
  metadata         Json?
  organizationId   String? // M8-P3：租户归属
  actorId          String? // 实际执行者（可为服务账号）
  requestId        String? // 全链路请求 ID
  traceId          String? // 分布式追踪 ID
  result           String? // success | denied | failed
  reason           String? // 拒绝/失败原因（脱敏后）
  createdAt        DateTime @default(now())
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([agentRunId])
  @@index([organizationId, createdAt])
  @@index([traceId])
}

// ===== M8-P1: Multi-tenancy / Organization / RBAC =====
enum OrganizationRole {
  owner
  admin
  member
  viewer
}

model Organization {
  id          String                 @id @default(uuid())
  name        String
  slug        String                 @unique
  isPersonal  Boolean                @default(false) // 个人默认组织（每用户一个，backfill + 懒创建）
  ownerUserId String
  status      OrganizationStatus     @default(active) // M10-P14：禁用态（全入口守卫拒绝；deletedAt 之外的第二治理态）
  deletedAt   DateTime?              // soft delete
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  members     OrganizationMember[]
  invitations OrganizationInvitation[]
  projects    Project[]
  agents      Agent[]
  workflows   Workflow[]
  connections Connection[]
  externalActions ExternalAction[]
  subscription Subscription?
  usageLedger  UsageLedgerEntry[]
  usageRecords UsageRecord[]
  metricSamples MetricSample[]
  scheduledJobs ScheduledJob[]
  eventEnvelopes EventEnvelope[]
  extensions Extension[]
  extensionInstallations ExtensionInstallation[]
  providerPolicies ProviderPolicy[]
  routingDecisions RoutingDecision[]
  quotaAlerts  QuotaAlert[]
  quotaReservations QuotaReservation[]
  evaluationDatasets EvaluationDataset[]
  evaluationRuns EvaluationRun[]
  evaluators Evaluator[]
  experiments Experiment[]
  extensionPublications ExtensionPublication[]
  creativeHypotheses CreativeHypothesis[] // M10-P4
  creativeInsights   CreativeInsight[]     // M10-P4
  extensionAllowlist ExtensionOrgAllowlist[] // M10-P14
  invoices     Invoice[]
  paymentEvents PaymentEvent[]
  @@index([ownerUserId])
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationRole @default(member)
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationInvitation {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email            String
  role             OrganizationRole @default(member)
  invitedByUserId  String
  token            String       @unique
  status           String       @default("pending") // pending | accepted | revoked | expired
  expiresAt        DateTime
  acceptedByUserId String?
  createdAt        DateTime     @default(now())
  @@index([organizationId, status])
}

// ===== M8-P2: Billing / Subscription / Quota（计量复用 UsageRecord，不建第二套）=====
model Plan {
  id          String   @id @default(uuid())
  code        String   @unique // free | pro | team | enterprise
  name        String
  monthlyPrice Float    @default(0)
  yearlyPrice  Float    @default(0)
  entitlements Json    // { llmTokensMonthly, imageMonthly, videoSecondsMonthly, externalApiMonthly, agentRunsMonthly, workflowRunsMonthly, storageMb, seats }
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  status         String   @default("active") // active | past_due | cancelled | expired
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([organizationId]) // 每组织一个订阅
  @@index([status])
}

model UsageLedgerEntry {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  projectId      String?
  kind           String   // llm_tokens | llm_cost | image_generation | video_seconds | external_api_call | agent_run | workflow_run | storage | seat
  quantity       Float    @default(0)
  unit           String   @default("count")
  runId          String?
  taskId         String?
  toolCallId     String?
  usageRecordId  String?  // 与 UsageRecord 关联（复用既有计量，不重复计费）
  idempotencyKey String   // 幂等：同键绝不重复计量
  period         String   // YYYY-MM（月度归集）
  metadata       Json?
  createdAt      DateTime @default(now())
  @@unique([idempotencyKey])
  @@index([organizationId, period])
  @@index([usageRecordId])
  @@index([runId])
  @@index([organizationId, kind, createdAt])
}

// Pre-M9 C1：配额预留（check-then-act 竞态修复——断言时预留、终态释放、TTL 兜底自愈；
// 多实例安全：预留行是 DB 事实而非进程内状态；过期行被动失效，清扫见可靠性包）
model QuotaReservation {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           String   // llm_tokens | image_generation | video_seconds | external_api_call | agent_run | workflow_run
  period         String   // YYYY-MM 月度预留
  day            String   // YYYY-MM-DD 当日预留
  quantity       Float    @default(1)
  refId          String   // runId / assistantMessageId / action idempotencyKey——同键幂等重预留
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  @@unique([organizationId, kind, refId])
  @@index([expiresAt])
}

model QuotaAlert {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           String   // monthly | daily | concurrent
  quotaKey       String   // llm_tokens | image_generation | ...
  thresholdPct   Int      @default(80)
  lastTriggeredAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([organizationId, kind, quotaKey, thresholdPct])
}

model Invoice {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId String?
  number         String   @unique
  status         String   @default("draft") // draft | open | paid | void
  amount         Float    @default(0)
  currency       String   @default("CNY")
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([organizationId])
}

model PaymentEvent {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String   @default("mock")
  providerEventId String  // 幂等：同 provider event 只入账一次
  type           String   // payment.succeeded | payment.failed | refund
  amount         Float    @default(0)
  currency       String   @default("CNY")
  invoiceId      String?
  metadata       Json?
  createdAt      DateTime @default(now())
  @@unique([provider, providerEventId])
  @@index([organizationId])
}

// ===== M9-P1 Evaluation / Experimentation（Coordinator 预整合；dataset 版本化 + run 锁定版本 + 可复现）=====
model EvaluationDataset {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  version        Int      @default(1) // 编辑 bump；run 锁定 (datasetId, datasetVersion)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cases          EvaluationCase[]
  runs           EvaluationRun[]
  @@index([organizationId])
}

model EvaluationCase {
  id        String   @id @default(uuid())
  datasetId String
  dataset   EvaluationDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  version   Int      // 所属 dataset 版本（编辑 bump 后旧版本行保留——不可变历史）
  input     Json     // 标准输入
  expected  Json?    // 期望输出（exact/schema 评测用）
  tags      Json?    // 分类标签数组
  createdAt DateTime @default(now())
  @@index([datasetId, version])
}

model EvaluationRun {
  id               String   @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  datasetId        String
  dataset          EvaluationDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetVersion   Int      // 锁定版本（绝不随 dataset 后续编辑漂移）
  agentId          String
  agentVersionId   String   // 锁定 Agent 版本（AgentVersion 不可变）
  configSnapshot   Json     // model/provider/temperature/tools 全量快照——可复现
  status           String   @default("pending") // pending|running|completed|failed|cancelled
  totalCases       Int      @default(0)
  completedCases   Int      @default(0)
  baselineRunId    String?  // 对比：baseline vs candidate（regression comparison）
  createdAt        DateTime @default(now())
  completedAt      DateTime?
  caseRuns         EvaluationCaseRun[]
  @@index([organizationId, createdAt])
}

model EvaluationCaseRun {
  id              String   @id @default(uuid())
  runId           String
  run             EvaluationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  caseId          String
  status          String   @default("pending") // pending|running|completed|failed|skipped
  input           Json
  output          Json?
  latencyMs       Int?
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  cost            Float    @default(0)
  toolCalls       Json?    // [{name, arguments, output}] 事实
  errorCode       String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?
  results         EvaluationResult[]
  @@unique([runId, caseId])
  @@index([runId])
}

model Evaluator {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           String   // exact_match | json_schema | rule | llm_judge
  config         Json     // schema/rules/judge prompt 模板 + judgeModelId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  results        EvaluationResult[]
  @@index([organizationId])
}

model EvaluationResult {
  id          String   @id @default(uuid())
  caseRunId   String
  caseRun     EvaluationCaseRun @relation(fields: [caseRunId], references: [id], onDelete: Cascade)
  evaluatorId String
  evaluator   Evaluator @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  score       Float    @default(0) // 0~1
  passed      Boolean  @default(false)
  evidence    Json?    // judge 引用/规则命中——只读事实（LLM judge 输出只进这里，绝不决定权限）
  createdAt   DateTime @default(now())
  @@unique([caseRunId, evaluatorId])
  @@index([evaluatorId]) // M10-P16：评测器结果计数（唯一索引前导列不可用）
}

model Experiment {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  status         String   @default("draft") // draft|running|completed|archived
  hypothesis     Json?    // 实验假设文本（业务记录，非判定依据）
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  variants       ExperimentVariant[]
  @@index([organizationId])
}

model ExperimentVariant {
  id               String   @id @default(uuid())
  experimentId     String
  experiment       Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  name             String
  agentId          String?
  agentVersionId   String?
  configSnapshot   Json
  isBaseline       Boolean  @default(false)
  trafficPercent   Int      @default(0)
  metrics          Json?    // 由 evaluation run 聚合的对照事实
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ===== M9-P2 Advanced Memory（记忆候选三态；sourceSummary 来源追溯）=====
model MemoryCandidate {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceSummaryId String?  // 提炼来源（摘要行；仅真实对话提炼——绝不从摘要循环污染）
  content         String   @db.Text
  category        MemoryCategory
  importance      Int      @default(50)
  confidence      Float    @default(0.5)
  status          String   @default("candidate") // candidate|active|rejected
  contentHash     String   // M10-P11：content sha256（去重约束锚点）
  createdAt       DateTime @default(now())
  promotedAt      DateTime?
  @@index([userId, status])
  @@unique([userId, contentHash]) // M10-P11：同一用户同内容候选绝不重复
  @@index([sourceSummaryId]) // M10-P16：会话删除/摘要重建清理路径
}

// ===== M9-P6 Marketplace 公开层（Coordinator 预整合；评分绝不提升权限——权限仍 = manifest ∩ 平台白名单 ∩ 组织策略）=====
model ExtensionPublication {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  extensionId    String   @unique // 一个扩展一份发布
  status         String   @default("draft") // draft|published|rejected
  category       String
  description    String
  changelog      Json?    // [{version, notes}]
  compatibility  Json?    // 平台版本兼容性声明
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reviews        ExtensionReview[]
  @@index([organizationId])
  @@index([status, category])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)]) // M10-P16：目录分页排序键
}

model ExtensionReview {
  id               String   @id @default(uuid())
  publicationId    String
  publication      ExtensionPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int      // 1~5（服务层校验）
  body             String?
  moderationStatus String   @default("pending") // pending|approved|rejected
  createdAt        DateTime @default(now())
  @@unique([publicationId, userId])
  @@index([publicationId, moderationStatus])
}

// ===== M8-P3~P7 平台层（Coordinator 预整合 schema；各 Phase 并行实现业务）=====

// ===== P3 Observability：AuditLog 增强 + 指标采样 =====
model MetricSample {
  id             String   @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name           String   // request_count | request_latency_ms | error_count | llm_latency_ms | llm_failures | tool_latency_ms | tool_failures | generation_latency_ms | generation_failures | queue_depth | queue_latency_ms | provider_latency_ms | provider_error_rate | agent_run_duration_ms | workflow_duration_ms
  value          Float    @default(0)
  unit           String   @default("count") // count | ms | percent
  labels         Json?    // { userId, providerId, queue, toolName, ... }
  sampledAt      DateTime @default(now())
  @@index([name, sampledAt])
  @@index([organizationId, sampledAt])
}

// ===== P4 Analytics：聚合投影（不破坏事务库；period+kind 幂等刷新）=====
// Pre-M9 S1：organizationId/userId NOT NULL（'global' 显式哨兵——绝不依赖 NULL 隐式全局，
// 否则 NULL-distinct 使唯一约束失效、并发刷新双写）
model AnalyticsAggregate {
  id             String   @id @default(uuid())
  organizationId String   // 组织 id 或哨兵 'global'（平台级聚合）
  userId         String   // 用户 id 或哨兵 'global'（组织级跨用户聚合）
  kind           String   // usage | cost | agent | tool | generation | provider | organization | workflow
  period         String   // YYYY-MM-DD（日粒度；month 由日聚合）
  dimensions     Json?    // { agentId, toolName, providerId, workflowId, ... }
  metrics        Json     // 事实指标（facts 层；绝不混入 LLM 解读）
  source         String   // usage_record | usage_ledger | agent_run | workflow_run（可追溯事务源）
  refreshedAt    DateTime @default(now())
  @@unique([organizationId, userId, kind, period, source])
  @@index([organizationId, period])
  @@index([kind, period])
}

// ===== P5 Scheduler / Event Platform =====
model ScheduledJob {
  id             String   @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  ownerUserId    String
  owner          User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name           String
  type           String   @default("one-shot") // one-shot | delayed | recurring
  cron           String?  // recurring
  runAt          DateTime? // one-shot/delayed
  status         String   @default("pending") // pending | scheduled | running | completed | failed | cancelled | dead
  priority       Int      @default(0)
  timeoutMs      Int      @default(60000)
  maxAttempts    Int      @default(3)
  backoffMs      Int      @default(2000)
  payload        Json?
  handler        String   // 消费处理器标识（服务端注册表；绝不执行任意代码）
  idempotencyKey String?
  traceId        String?
  lastError      String?
  attempts       Int      @default(0)
  scheduledAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([idempotencyKey])
  @@index([organizationId, status])
  @@index([runAt])
  @@index([status, runAt])
}

model EventEnvelope {
  id             String   @id @default(uuid())
  eventId        String   @unique // 幂等：同 eventId 只入一次
  eventType      String
  version        Int      @default(1)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId      String?
  actorId        String?
  aggregateType  String?
  aggregateId    String?
  payload        Json?
  occurredAt     DateTime @default(now())
  traceId        String?
  status         String   @default("published") // published | consumed | failed | dead
  attempts       Int      @default(0)
  lastError      String?
  consumedAt     DateTime?
  createdAt      DateTime @default(now())
  @@index([eventType, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([aggregateType, aggregateId])
  @@index([status, occurredAt])
}

// ===== P6 Extension SDK（manifest/权限/安装；绝不执行任意第三方代码）=====
model Extension {
  id          String   @id @default(uuid())
  organizationId String? // 组织私有扩展；null = 平台级
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  ownerUserId String
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String
  slug        String   @unique
  description String?
  kind        String   // tool | agent | provider | workflow_step
  status      String   @default("draft") // draft | published | deprecated | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  versions    ExtensionVersion[]
  allowlistedOrgs ExtensionOrgAllowlist[] // M10-P14：组织级使用白名单
  @@index([organizationId, status])
}

model ExtensionVersion {
  id          String   @id @default(uuid())
  extensionId String
  extension   Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  version     Int
  manifest    Json     // 声明式定义（custom tool 参数约束 / agent 模板 / workflow step 声明）——绝不含可执行代码
  checksum    String   // sha256(manifest)
  signature   String?  // 签名（预留；校验在服务层）
  status      String   @default("draft") // draft | published | deprecated | archived
  createdAt   DateTime @default(now())
  permissions ExtensionPermission[]
  @@unique([extensionId, version])
}

model ExtensionPermission {
  id        String           @id @default(uuid())
  versionId String
  version   ExtensionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  name      String           // tool.execute | workflow.step | agent.run | provider.call | config.read | config.write
  scope     String           @default("organization") // organization | project | user
  description String?
  @@unique([versionId, name])
}

model ExtensionInstallation {
  id          String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  extensionId String
  versionId   String   // 版本锁定（installation 绝不漂移）
  status      String   @default("enabled") // enabled | disabled
  config      Json?
  installedByUserId String
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([organizationId, extensionId])
  @@index([organizationId, status])
}

// ===== P7 Provider Routing（能力/策略/决策审计）=====
model ProviderCapability {
  id         String   @id @default(uuid())
  providerId String
  capability String   // text_generation | image_generation | video_generation | embedding | function_calling | vision
  modelIds   Json?    // 支持该能力的模型清单
  contextWindow Int?
  features   Json?    // { maxTokens, supportedModes, ... }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([providerId, capability])
  @@index([capability])
}

model ProviderPolicy {
  id          String   @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  providerId  String
  allow       Boolean  @default(true) // allow/deny list
  priority    Int      @default(100)  // 偏好排序（低值优先）
  costCeilingPerRequest Float?
  costCeilingMonthly    Float?
  dataPolicy  Json?    // { regions, allowedKinds, ... }
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([organizationId, providerId])
  @@index([organizationId, enabled])
}

model RoutingDecision {
  id          String   @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  requestId   String?
  traceId     String?
  runId       String?
  taskId      String?
  capability  String   // 路由目标能力（text_generation 等）
  providerId  String?  // 最终选择
  candidates  Json     // 候选清单（含被拒原因）
  reasonCode  String   // capability_match | cost_optimal | health_score | policy_allow | fallback | circuit_open | denied
  policyId    String?
  estimatedCost Float?
  actualCost    Float?
  decidedAt   DateTime @default(now())
  @@index([organizationId, decidedAt])
  @@index([runId])
  @@index([providerId, decidedAt])
}

// ===== M10 W0（Coordinator 单点预整合）：P4 创意假设/洞察专表 + P14 扩展白名单 + P14 组织状态枚举 =====

enum OrganizationStatus {
  active
  disabled // M10-P14：禁用态——所有入口守卫拒绝；与 deletedAt（软删）是不同治理动作
}

enum CreativeHypothesisStatus {
  draft
  ready
  running
  validated
  rejected
}

// M10-P4：创意假设专表（替代 Artifact(type='other') JSONB 容器——DB 级 CHECK/外键/组织直列/版本列）
model CreativeHypothesis {
  id              String                   @id @default(uuid())
  organizationId  String
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId          String
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          CreativeHypothesisStatus @default(draft)
  statement       String                   @db.Text
  rationale       String?
  target          String?
  platform        String?
  insightId       String? // 来源洞察引用（仅引用，绝不改写洞察事实）
  successCriteria Json?
  loop            Json?   // HypothesisLoopRef（workflowId/runId/attempts/startedAt——loop 执行记录由 WorkflowRun 承载，不建冗余表）
  evaluationRunId String?
  baselineRunId   String?
  experimentId    String?
  verdict         Json?
  history         Json?   // 状态历史（from/to/at/by）
  version         Int      @default(1) // 非状态字段 CAS 锚点（状态维度由 status CAS 保证）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([organizationId, status])
  @@index([projectId])
  @@index([organizationId, createdAt])
}

// M10-P4：创意洞察专表（facts/derived/interpretation 三层隔离 + factsHash CAS 锚点）
model CreativeInsight {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  window         Json
  filters        Json
  facts          Json
  derived        Json
  factsHash      String
  interpretation Json?
  layering       Json
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([organizationId, createdAt])
  @@index([organizationId, factsHash])
}

// M10-P14：扩展的组织级使用白名单（resolveEffectiveAgentTools 的 orgAllowlist 参数落点）
model ExtensionOrgAllowlist {
  id             String       @id @default(uuid())
  extensionId    String
  extension      Extension    @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  @@unique([extensionId, organizationId])
}
