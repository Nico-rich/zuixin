# ===== 数据库 =====
DATABASE_URL=postgresql://agent:agent_dev_password@localhost:5433/agent_platform

# ===== Redis / 队列 =====
REDIS_URL=redis://localhost:6379

# ===== 安全 =====
# ⚠️ 以下两个值在 NODE_ENV=production 下是**启动阻断项**：占位/缺失/过短一律 fail-fast 拒绝启动
#    （守卫实现见 apps/api/src/modules/security/production-guards.ts；单测见同目录 *.spec.ts）。
# 生产生成方式: openssl rand -base64 32
# 占位值故意写成明显非法：即使被误复制到生产也会被守卫拦下（而不是"看起来像真密钥"）。
JWT_SECRET=__INSECURE_PLACEHOLDER_REPLACE_ME__
# 生成方式: openssl rand -base64 32（API Key 落库加密用，必须是 base64 编码的 32 字节密钥；设置后不可随意更改）
# 多密钥轮换（M10-P1，可选）：ENCRYPTION_KEYS="1:<旧密钥>,2:<当前密钥>"，digits 越大越新；
# 与单 ENCRYPTION_KEY 互斥（后者等价于版本 1）。凭证按 keyVersion 解密，未知版本抛 KEY_VERSION_INVALID（绝不静默降级）。
# ENCRYPTION_KEYS=
ENCRYPTION_KEY=__INSECURE_PLACEHOLDER_REPLACE_ME__

# ===== 会话治理（M10-P1）=====
# 每用户活跃会话上限（超过后按 SESSION_CONCURRENCY_POLICY 处理）
# SESSION_MAX_CONCURRENT=5
# evict-oldest（默认，挤掉最旧会话，用户始终可登录）| reject（拒绝新登录，返回 SESSION_CONCURRENCY_EXCEEDED）
# SESSION_CONCURRENCY_POLICY=evict-oldest
# AccessGuard 肯定缓存 TTL（跨实例撤销靠 Redis pub/sub `session-events` 立即传播，TTL 只兜底）
# SECURITY_GUARD_CACHE_TTL_MS=5000

# ===== 全局限流（M10-P8，per-IP × 方法 × 端点）=====
# 策略与阈值矩阵集中在 apps/api/src/core/rate-limit/global-rate-limit.policy.ts（纯函数，含豁免清单：
# 健康探针 / CORS 预检 / webhook / SSE 长连接）。与既有路由级 @RateLimit 桶**并存且不叠加同一计数器**。
# 生产默认：read 300/min、write 60/min、auth(login|refresh) 30/min、upload 30/min，窗口 60s。
# 非生产（NODE_ENV != production）默认按 100 倍放宽（防 e2e/本地开发互相污染成 429）；
# **显式设置任一阈值即按显式值生效**（任何环境优先——运维收紧阈值走这条路径）。
# 关闭开关只认显式 false；非法值按未设置处理（默认启用，绝不因拼写错误静默关闭防护）。
# GLOBAL_RATE_LIMIT_ENABLED=true
# GLOBAL_RATE_LIMIT_PER_MIN=300
# GLOBAL_RATE_LIMIT_WRITE_PER_MIN=60
# GLOBAL_RATE_LIMIT_AUTH_PER_MIN=30
# GLOBAL_RATE_LIMIT_UPLOAD_PER_MIN=30
# GLOBAL_RATE_LIMIT_WINDOW_MS=60000

# ===== 反向代理可信跳（M10-P1 × M10-P8 统一口径）=====
# 本 API 前面**可信**代理的层数（默认 0 = 不信任任何 X-Forwarded-For，一律用 socket 地址）。
# 语义 = "取 XFF 链右起第 N 跳"（客户端只能往左追加；边界代理追加的那一跳抗伪造；链长不足回退 socket 地址）。
# N>0 时启动会设置 Express `trust proxy = N`，使 auth 失败计数用的 req.ip 与全局限流的
# resolveClientIp(hops) 口径一致（见 apps/api/src/modules/security/trusted-proxy.ts）；N=0 时不动 Express。
# ⚠️ 只有确实部署了 N 层可信反代才可设置：直连部署设置它等于把分桶/计数依据交给可伪造头部。
# TRUSTED_PROXY_HOPS=0

# ===== 开发替身开关（NODE_ENV=production 下一律拒绝启动）=====
# MOCK_DELAY_MS / MOCK_LLM_FAILURE / MOCK_LLM_STALL_MS / MOCK_EMBEDDING_DIMS / LLM_RETRY_BACKOFF_MS
# 仅用于本地零配置与测试故障注入；生产启用会被 production-guards 拦截（避免可被外部触发的故障注入面）。

# ===== 服务 =====
API_PORT=3001
WEB_PORT=3000
# （M11 Final Audit M31：APP_URL 全仓无读取点，已移除；真正生效的是 NEXT_PUBLIC_API_URL）
# （M11 Final Audit M31：WEB_URL 全仓无读取点，已移除；真正生效的是 NEXT_PUBLIC_API_URL）
# CORS 白名单（逗号分隔）
CORS_ORIGINS=http://localhost:3000

# ===== 对象存储 =====
# local（开发，写 ./data/storage）| s3-compatible（MinIO/R2/S3）
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
STORAGE_BUCKET=agent-storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_REGION=us-east-1

# ===== 种子数据 =====
# 初始管理员账号（seed 创建）
SEED_ADMIN_EMAIL=admin@example.com
# ⚠️ NODE_ENV=production 下 seed 拒绝用默认口令（admin123456 等）/占位口令/长度<12 的口令初始化管理员
SEED_ADMIN_PASSWORD=__INSECURE_PLACEHOLDER_REPLACE_ME__

# ===== M11 新增（按 Phase；均有安全默认，可不配）=====
# P8 指标保留：MetricSample 保留天数（默认 30）
# METRIC_RETENTION_DAYS=30
# P8 周期任务开通探测（默认 15min 探测 / 30s 起指数退避至 15min）
# RECURRING_JOB_PROBE_MS=900000
# RECURRING_JOB_RETRY_BASE_MS=30000
# RECURRING_JOB_RETRY_MAX_MS=900000
# P11 对象存储 S3 SDK 超时（建连 5s / 请求 30s；非法值回退默认）
# STORAGE_S3_CONNECT_TIMEOUT_MS=5000
# STORAGE_S3_REQUEST_TIMEOUT_MS=30000
# STORAGE_DEADLINE_MS=35000
# P2 安全守卫缓存容量上限（默认 5000）
# SECURITY_GUARD_CACHE_MAX_ENTRIES=5000
# P14 知识库 HNSW 检索 GUC（显式事务内钉死；默认 ef_search=40 / random_page_cost=1.1）
# KNOWLEDGE_HNSW_EF_SEARCH=40
# KNOWLEDGE_HNSW_RANDOM_PAGE_COST=1.1
# P4 路由延迟聚合 TTL 缓存（默认 45s）
# ROUTING_LATENCY_CACHE_TTL_MS=45000
# P1 多密钥轮换（逗号分隔 v:base64-32字节；轮换后跑 scripts/rewrap.ts）
# ENCRYPTION_KEYS=1:change_me_v1,2:change_me_v2
# M13+ 测试基建（生产绝不设置）：进程启动时幂等启用 mock 替身（vitest setupFile / Playwright stack 自动注入）
# TEST_ENSURE_MOCK_PROVIDERS=1
# M13+ 模型配置：允许 provider baseUrl 使用 http://（默认仅 https；SSRF 判定双端一致）
# PROVIDER_ALLOW_HTTP=true
